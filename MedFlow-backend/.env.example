# ============================================================
# 云诊易 MedFlow — 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=medflow

# ---- JWT ----
JWT_SECRET_KEY=生成一个随机字符串，至少32位
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- 邮箱 SMTP（QQ邮箱为例）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASSWORD=QQ邮箱的SMTP授权码（不是QQ密码）

# ---- 文件上传 ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ---- 安全参数 ----
CODE_LENGTH=6
CODE_EXPIRE_MINUTES=5
CODE_MAX_ATTEMPTS=3
CODE_SEND_INTERVAL_SEC=60
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUDIT_LOG_RETENTION_DAYS=1095
SYSTEM_NAME=云诊易
